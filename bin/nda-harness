#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v python3 >/dev/null 2>&1; then
  echo 'NDA Harness requires Python 3.11+ on PATH; dependencies are already bundled.' >&2
  exit 2
fi
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,11) else 1)'; then
  echo 'NDA Harness requires Python 3.11+; dependencies are already bundled.' >&2
  exit 2
fi
exec python3 "$root/scripts/nda_harness/cli.py" "$@"
