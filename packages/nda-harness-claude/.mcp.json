{
  "mcpServers": {
    "nda-harness-context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "nda-harness-hindsight": {
      "headers": {
        "X-Hindsight-Coding-Agent": "claude-code"
      },
      "type": "http",
      "url": "https://hindsight-api.pila.vn/mcp/"
    },
    "nda-harness-jev": {
      "args": [
        "selection-mcp",
        "--client",
        "claude"
      ],
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/nda-plugin",
      "type": "stdio"
    },
    "nda-harness-nda-rag": {
      "type": "http",
      "url": "https://docs-dev.chainhub.vn/api/mcp"
    }
  }
}
