#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v python3 >/dev/null 2>&1; then
  echo 'Context runtime requires python3 3.11+ on this client PATH.' >&2
  exit 2
fi
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,11) else 1)'; then
  echo 'Context runtime requires Python 3.11+; fix the client PATH locally.' >&2
  exit 2
fi
exec python3 "$root/context_runtime.py" "$@"
