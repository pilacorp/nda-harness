{
  "mcpServers": {
    "nda-harness-context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "nda-harness-hindsight": {
      "http_headers": {
        "X-Hindsight-Coding-Agent": "codex"
      },
      "type": "http",
      "url": "https://hindsight-api.pila.vn/mcp/"
    },
    "nda-harness-jev": {
      "args": [
        "bin/nda-plugin",
        "selection-mcp",
        "--client",
        "codex"
      ],
      "command": "/bin/sh",
      "cwd": ".",
      "type": "stdio"
    },
    "nda-harness-nda-rag": {
      "type": "http",
      "url": "https://docs-dev.chainhub.vn/api/mcp"
    }
  }
}
