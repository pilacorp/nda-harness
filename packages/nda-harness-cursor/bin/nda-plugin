#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,9) else 1)'; then
  echo 'NDA Harness requires Python 3.9+ on the client PATH; dependencies are bundled.' >&2
  exit 2
fi
export PYTHONDONTWRITEBYTECODE=1
exec python3 "$root/scripts/nda_harness/plugin_runtime.py" "$@"
