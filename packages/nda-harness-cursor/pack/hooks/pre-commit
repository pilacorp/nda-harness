#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel) || exit 1
if ! command -v python3 >/dev/null 2>&1; then
  echo 'NDA pre-commit requires Python 3.11+ on PATH.' >&2
  exit 1
fi
if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,11) else 1)'; then
  echo 'NDA pre-commit requires Python 3.11+.' >&2
  exit 1
fi
exec python3 "$root/.nda-harness/scripts/unit_check.py" "$root"
